# Job Hunt Tailor – environment config
# Copy this to .env and fill in your values

# Optional: OpenAI-compatible API key for LLM-powered generation.
# If omitted, the app uses the built-in template engine instead.
OPENAI_API_KEY=

# Model to use when an API key is configured.
OPENAI_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible APIs (default: OpenAI).
# Override for Azure OpenAI, Ollama, or other compatible providers.
OPENAI_BASE_URL=https://api.openai.com/v1

# SQLite database path (relative to where uvicorn is started).
DATABASE_URL=sqlite:///./job_hunt_tailor.db

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
